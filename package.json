{
  "name": "homebridge-toyota",
  "displayName": "Homebridge Toyota",
  "version": "0.4.3",
  "description": "Native HomeKit lock, door sensors and EV battery for Toyota North America vehicles via Toyota Connected Services.",
  "author": "Oliver Ames",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/oliverames/homebridge-toyota#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliverames/homebridge-toyota.git"
  },
  "keywords": [
    "homebridge-plugin",
    "toyota",
    "homekit",
    "lock"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22 || ^24",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "homebridge": "^1.8.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
